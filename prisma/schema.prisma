generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String               @id @default(uuid())
  name                      String
  email                     String
  emailVerified             Boolean              @default(false)
  image                     String?
  role                      String               @default("student")
  banned                    Boolean              @default(false)
  banReason                 String?
  banExpires                DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  sessions                  Session[]
  accounts                  Account[]
  exams                     Exam[]               @relation("CreatedExams")
  bankQuestions             BankQuestion[]
  examAssignments           ExamAssignment[]     @relation("AssignedExams")
  createdAssignments        ExamAssignment[]     @relation("CreatedAssignments")
  examProctors              ExamProctor[]        @relation("ProctorExams")
  createdProctorAssignments ExamProctor[]        @relation("CreatedProctorAssignments")
  examAttempts              ExamAttempt[]
  publishedReports          ReportVerification[] @relation("PublishedReports")
  publishedResults          Exam[]               @relation("PublishedResults")
  gradedAttempts            ExamAttempt[]        @relation("GradedAttempts")
  gradedAnswers             Answer[]             @relation("GradedAnswers")
  gradeAudits               GradeAudit[]         @relation("GradeAudits")
  incidentsAsCandidate      ExamIncident[]       @relation("IncidentCandidates")
  reportedIncidents         ExamIncident[]       @relation("ReportedIncidents")
  resolvedIncidents         ExamIncident[]       @relation("ResolvedIncidents")
  examAnnouncements         ExamAnnouncement[]   @relation("ExamAnnouncements")
  announcementReads         AnnouncementRead[]   @relation("AnnouncementReads")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id @default(uuid())
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Exam {
  id                   String    @id @default(uuid())
  title                String
  description          String?
  instructions         String?
  duration             Int
  startTime            DateTime?
  endTime              DateTime?
  /// Stored: draft | published | completed. Never store "ongoing".
  status               String    @default("draft")
  /// Snapshot of SUM(question.points); kept in sync on draft edits and publish.
  totalMarks           Int       @default(0)
  /// Per-attempt shuffle of question order at startExam.
  shuffleQuestions     Boolean   @default(false)
  /// Per-attempt shuffle of choice option display order at startExam.
  shuffleOptions       Boolean   @default(false)
  /// Null = results hidden from candidates. Set by publishResults.
  resultsPublishedAt   DateTime?
  resultsPublishedById String?
  resultsPublishedBy   User?     @relation("PublishedResults", fields: [resultsPublishedById], references: [id], onDelete: SetNull)
  /// none | score_only | score_and_answers — what candidates see once published
  resultReveal         String    @default("score_and_answers")
  /// Optional pass threshold in percent (0-100) for analytics and badges
  passMarkPercent      Int?
  createdById          String
  createdBy            User      @relation("CreatedExams", fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  questions     Question[]
  assignments   ExamAssignment[]
  proctors      ExamProctor[]
  attempts      ExamAttempt[]
  announcements ExamAnnouncement[]
  incidents     ExamIncident[]
  events        AttemptEvent[]
  gradeAudits   GradeAudit[]

  @@index([createdById])
  @@map("exam")
}

model ExamAssignment {
  id           String   @id @default(uuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("AssignedExams", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("CreatedAssignments", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())
  status       String   @default("assigned")

  @@unique([examId, userId])
  @@index([examId])
  @@index([userId])
  @@map("exam_assignment")
}

model ExamProctor {
  id           String   @id @default(uuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  proctorId    String
  proctor      User     @relation("ProctorExams", fields: [proctorId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("CreatedProctorAssignments", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([examId, proctorId])
  @@index([examId])
  @@index([proctorId])
  @@map("exam_proctor")
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topics      Topic[]

  @@unique([name])
  @@map("subject")
}

model Topic {
  id          String         @id @default(uuid())
  name        String
  description String?
  order       Int            @default(0)
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  questions   BankQuestion[]

  @@unique([subjectId, name])
  @@index([subjectId])
  @@map("topic")
}

model BankQuestion {
  id            String   @id @default(uuid())
  text          String
  type          String   @default("multiple_choice")
  options       String?
  answer        String?
  points        Int      @default(1)
  /// easy | medium | hard
  difficulty    String   @default("medium")
  /// JSON marking scheme (see src/lib/exam/markingScheme.ts)
  markingScheme String?
  topicId       String
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdById])
  @@index([topicId])
  @@index([difficulty])
  @@map("bank_question")
}

model Question {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  text          String
  type          String   @default("multiple_choice")
  options       String?
  answer        String?
  points        Int      @default(1)
  order         Int      @default(0)
  /// easy | medium | hard (copied from bank on import)
  difficulty    String   @default("medium")
  /// JSON marking scheme snapshot from bank / editor
  markingScheme String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  answers          Answer[]
  attemptQuestions AttemptQuestion[]

  @@index([examId])
  @@map("question")
}

model ExamAttempt {
  id           String    @id @default(uuid())
  userId       String
  examId       String
  /// in_progress | submitted (awaiting manual grading) | graded
  status       String    @default("in_progress")
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  /// Sum of auto-graded answer scores
  autoScore    Float?
  /// Sum of manually graded answer scores
  manualScore  Float?
  /// Final total; null while manual grading is pending
  totalScore   Float?
  maxScore     Int       @default(0)
  gradedAt     DateTime?
  gradedById   String?
  gradedBy     User?     @relation("GradedAttempts", fields: [gradedById], references: [id], onDelete: SetNull)
  /// manual | timer | resume_finalize | server_sweep
  submitSource String?
  /// Liveness, written with server time only
  lastSeenAt   DateTime?
  lastSyncAt   DateTime?
  clientOnline Boolean   @default(true)
  /// Client-reported unsynced answer count (informational only)
  pendingLocal Int       @default(0)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam      Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers   Answer[]
  questions AttemptQuestion[]
  events    AttemptEvent[]
  incidents ExamIncident[]

  @@unique([userId, examId])
  @@index([examId])
  @@index([userId])
  @@map("exam_attempt")
}

/// Frozen copy of an exam Question at attempt start. Grading uses these rows only.
model AttemptQuestion {
  id               String      @id @default(uuid())
  attemptId        String
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// Exam Question.id at snapshot time (informational / dual-write Answer.questionId)
  sourceQuestionId String
  sourceQuestion   Question    @relation(fields: [sourceQuestionId], references: [id], onDelete: Restrict)
  text             String
  type             String
  options          String?
  answer           String?
  points           Int         @default(1)
  order            Int         @default(0)
  difficulty       String      @default("medium")
  markingScheme    String?
  /// Display order of options when shuffleOptions is on (newline-separated texts)
  optionOrder      String?
  createdAt        DateTime    @default(now())

  answers Answer[]

  @@unique([attemptId, sourceQuestionId])
  @@index([attemptId])
  @@index([sourceQuestionId])
  @@map("attempt_question")
}

model Answer {
  id                String    @id @default(uuid())
  attemptId         String
  questionId        String
  attemptQuestionId String?
  text              String?
  /// Final score; null while manual grading is pending
  score             Float?
  autoScore         Float?
  manualScore       Float?
  feedback          String?
  requiresManual    Boolean   @default(false)
  gradedById        String?
  gradedAt          DateTime?
  /// Monotonic per (attempt, question), assigned by the client sync queue
  clientSeq         Int       @default(0)
  idempotencyKey    String?
  serverUpdatedAt   DateTime  @default(now()) @updatedAt

  attempt         ExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptQuestion AttemptQuestion? @relation(fields: [attemptQuestionId], references: [id], onDelete: SetNull)
  gradedBy        User?            @relation("GradedAnswers", fields: [gradedById], references: [id], onDelete: SetNull)
  audits          GradeAudit[]

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([attemptQuestionId])
  @@map("answer")
}

/// Audit trail for grading and result publication.
/// action: grade | override | regrade | publish | unpublish (answerId null for publish/unpublish)
model GradeAudit {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  answerId      String?
  answer        Answer?  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  action        String
  previousScore Float?
  newScore      Float?
  reason        String?
  gradedById    String
  gradedBy      User     @relation("GradeAudits", fields: [gradedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([examId, createdAt])
  @@index([answerId])
  @@map("grade_audit")
}

/// Automated workspace signals (server-timestamped). Context only — never proof of misconduct.
/// type: connection_lost | connection_restored | tab_hidden | tab_visible | window_blur |
///       multiple_tabs | sync_conflict | sync_failed | resumed_after_refresh | auto_submitted
model AttemptEvent {
  id        String      @id @default(uuid())
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  type      String
  /// Short JSON (max 500 chars). Never contains answer text.
  detail    String?
  createdAt DateTime    @default(now())

  @@index([examId, createdAt])
  @@index([attemptId, createdAt])
  @@map("attempt_event")
}

/// Human-recorded incident during an exam.
model ExamIncident {
  id             String       @id @default(uuid())
  examId         String
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  attemptId      String?
  attempt        ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  candidateId    String?
  candidate      User?        @relation("IncidentCandidates", fields: [candidateId], references: [id], onDelete: SetNull)
  reportedById   String
  reportedBy     User         @relation("ReportedIncidents", fields: [reportedById], references: [id])
  /// technical | conduct | identity | environment | other
  category       String
  /// low | medium | high
  severity       String       @default("low")
  description    String
  /// open | under_review | resolved | dismissed
  status         String       @default("open")
  resolutionNote String?
  resolvedById   String?
  resolvedBy     User?        @relation("ResolvedIncidents", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([examId, status])
  @@index([attemptId])
  @@map("exam_incident")
}

/// Message from staff to all candidates of an exam.
model ExamAnnouncement {
  id          String             @id @default(uuid())
  examId      String
  exam        Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  authorId    String
  author      User               @relation("ExamAnnouncements", fields: [authorId], references: [id])
  message     String
  /// info | important | urgent
  priority    String             @default("info")
  createdAt   DateTime           @default(now())
  retractedAt DateTime?
  reads       AnnouncementRead[]

  @@index([examId, createdAt])
  @@map("exam_announcement")
}

model AnnouncementRead {
  announcementId String
  announcement   ExamAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("AnnouncementReads", fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime         @default(now())

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_read")
}

/// Publicly verifiable published report metadata (no PII / answers in QR payload).
model ReportVerification {
  id            String    @id @default(uuid())
  /// candidate_result | exam_summary
  type          String
  examId        String?
  attemptId     String?
  /// SHA-256 hex of canonical non-PII report payload (server-computed)
  contentHash   String
  /// Public-safe fields for verification page (JSON): examTitle, score, maxScore, pct, publishedAt
  publicMeta    String
  publishedById String
  publishedBy   User      @relation("PublishedReports", fields: [publishedById], references: [id])
  publishedAt   DateTime  @default(now())
  revokedAt     DateTime?

  @@index([examId])
  @@index([attemptId])
  @@index([contentHash])
  @@map("report_verification")
}

model ImportJob {
  id          String   @id @default(uuid())
  /// candidates | bank_questions | exam_results_export (audit)
  kind        String
  status      String   @default("completed")
  fileName    String?
  rowCount    Int      @default(0)
  validCount  Int      @default(0)
  errorCount  Int      @default(0)
  createdById String
  summary     String?
  createdAt   DateTime @default(now())

  @@index([createdById])
  @@index([kind])
  @@map("import_job")
}
