# Postgres (Supabase). Never commit real credentials.
# If the password contains @, URL-encode it as %40.
# For Node pg + Supabase TLS, keep uselibpqcompat=true&sslmode=require.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&uselibpqcompat=true"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&uselibpqcompat=true"
# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_ALLOWED_ORIGINS="http://localhost:3000"
BETTER_AUTH_SEED_ADMIN_EMAIL="admin@example.com"
BETTER_AUTH_TELEMETRY="0"

# Prisma telemetry
CHECKPOINT_DISABLE="1"

# Optional avatar storage with Cloudinary
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
# CLOUDINARY_FOLDER_MODE="dynamic"

# Optional AI-assisted written grading (server-only — never NEXT_PUBLIC_)
# GROQ_API_KEY=
# GROQ_MODEL="llama-3.3-70b-versatile"
# AI_GRADING_ENABLED="true"
# AI_GRADING_MAX_RETRIES="2"
# AI_GRADING_TIMEOUT_MS="20000"
# AI_GRADING_REVIEW_THRESHOLD="0.70"
